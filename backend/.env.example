# --- Database (MUST be UTF8: norm_status uses normalize()) ---
DATABASE_URL=postgresql+asyncpg://bidsa:bidsa@localhost:5432/bidsa
DATABASE_URL_SYNC=postgresql+psycopg2://bidsa:bidsa@localhost:5432/bidsa

# --- Etimad official API ---
ETIMAD_BASE_URL=https://tenders.etimad.sa
ETIMAD_PAGE_SIZE=50
ETIMAD_PUBLISH_DATE_ID=5
ETIMAD_MAX_PAGES=200

# --- AI (optional; pipeline degrades gracefully without a key) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Company profile (keyword fallback) ---
COMPANY_NAME=
COMPANY_ACTIVITIES=

# --- Scheduler ---
SCRAPER_INTERVAL_MINUTES=60
ENABLE_SCHEDULER=true

SECRET_KEY=change-me-in-production
